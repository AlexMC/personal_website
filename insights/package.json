{
  "name": "insights",
  "version": "1.0.0",
  "private": true,
  "description": "Private dashboard tracking search rankings and AI-answer visibility for alexcarvalho.me",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8799 --local-upstream localhost:8799",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply insights --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.148.0"
  }
}
